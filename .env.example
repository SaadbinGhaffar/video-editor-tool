# Speech-to-text for word-level timing. If unset, the app falls back to a local
# whisper.cpp install (run `npm run setup:whisper` once).
OPENAI_API_KEY=
# ...or use Groq instead (OpenAI wins if both are set):
# GROQ_API_KEY=

# Optional: model used for niche detection when a key is set
# (defaults: gpt-4.1-mini on OpenAI, qwen/qwen3.8-27b on Groq).
# NICHE_MODEL=gpt-4.1-mini

# Vercel deployment
# APP_ACCESS_KEY=   # require this key in the UI/API (recommended on public URLs)
# CRON_SECRET=      # protects /api/cleanup
# SANDBOX_VCPUS=4
